<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CT.Desktop.Converters">

    <SolidColorBrush x:Key="Primaire" Color="#1A73E8"/>
    <SolidColorBrush x:Key="PrimaireFonce" Color="#1557B0"/>
    <SolidColorBrush x:Key="Fond" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="Carte" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bordure" Color="#DADCE0"/>
    <SolidColorBrush x:Key="Texte" Color="#202124"/>
    <SolidColorBrush x:Key="TexteSecondaire" Color="#5F6368"/>
    <SolidColorBrush x:Key="Erreur" Color="#D93025"/>
    <SolidColorBrush x:Key="Succes" Color="#1E8E3E"/>
    <SolidColorBrush x:Key="Menu" Color="#202938"/>

    <BooleanToVisibilityConverter x:Key="BoolVisibilite"/>
    <conv:LibelleEnumConverter x:Key="Libelle"/>
    <conv:EnumEgalConverter x:Key="EnumEgal"/>
    <conv:NullVersVisibiliteConverter x:Key="NullVisibilite"/>
    <conv:NullVersVisibiliteConverter x:Key="NullInvisibilite" Inverser="True"/>
    <conv:CouleurResultatConverter x:Key="CouleurResultat"/>

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="TitrePage" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    </Style>

    <Style x:Key="TitreCarte" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    </Style>

    <Style x:Key="Etiquette" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}"/>
        <Setter Property="Margin" Value="0,8,0,3"/>
    </Style>

    <Style x:Key="CarteStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Carte}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primaire}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoutonSecondaire" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Primaire}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BoutonDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Erreur}"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F1F3F4"/>
        <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E8F0FE"/>
                <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MessageErreur" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Erreur}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NullVisibilite}}"/>
    </Style>

    <Style x:Key="MessageSucces" TargetType="TextBlock" BasedOn="{StaticResource MessageErreur}">
        <Setter Property="Foreground" Value="{StaticResource Succes}"/>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
</ResourceDictionary>
