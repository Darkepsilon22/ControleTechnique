<UserControl x:Class="CT.Desktop.Views.TableauDeBordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ValeurKpi" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Du" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding Du}" Width="130"/>
                    <TextBlock Text="au" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <DatePicker SelectedDate="{Binding Au}" Width="130"/>
                    <Button Content="Actualiser" Command="{Binding ActualiserCommand}" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Tableau de bord" Style="{StaticResource TitrePage}" Margin="0"/>
            </DockPanel>

            <UniformGrid Columns="5" Margin="0,0,0,16">
                <Border Style="{StaticResource CarteStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Contrôles périodiques" Foreground="{StaticResource TexteSecondaire}"/>
                        <TextBlock Text="{Binding Statistiques.TotalControles}" Style="{StaticResource ValeurKpi}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CarteStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Favorables (A)" Foreground="{StaticResource TexteSecondaire}"/>
                        <TextBlock Text="{Binding Statistiques.TauxFavorable, StringFormat={}{0} %}" Style="{StaticResource ValeurKpi}" Foreground="{StaticResource Succes}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CarteStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Défavorables (S)" Foreground="{StaticResource TexteSecondaire}"/>
                        <TextBlock Text="{Binding Statistiques.DefavorablesMajeurs}" Style="{StaticResource ValeurKpi}" Foreground="#E37400"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CarteStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Défavorables (R)" Foreground="{StaticResource TexteSecondaire}"/>
                        <TextBlock Text="{Binding Statistiques.DefavorablesCritiques}" Style="{StaticResource ValeurKpi}" Foreground="{StaticResource Erreur}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CarteStyle}">
                    <StackPanel>
                        <TextBlock Text="Contre-visites" Foreground="{StaticResource TexteSecondaire}"/>
                        <TextBlock Text="{Binding Statistiques.ContreVisites}" Style="{StaticResource ValeurKpi}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CarteStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Contrôles par mois" Style="{StaticResource TitreCarte}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Rectangle Width="12" Height="12" Fill="#C6DAFC" Margin="0,0,6,0"/>
                            <TextBlock Text="Total" FontSize="12" Margin="0,0,16,0"/>
                            <Rectangle Width="12" Height="12" Fill="{StaticResource Primaire}" Margin="0,0,6,0"/>
                            <TextBlock Text="Favorables" FontSize="12"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Barres}" Height="230">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Bottom" Width="52">
                                        <TextBlock Text="{Binding Total}" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TexteSecondaire}"/>
                                        <Grid Height="{Binding HauteurTotal}" VerticalAlignment="Bottom" ToolTip="{Binding Favorables, StringFormat={}{0} favorable(s)}">
                                            <Rectangle Fill="#C6DAFC" RadiusX="3" RadiusY="3"/>
                                            <Rectangle Fill="{StaticResource Primaire}" Height="{Binding HauteurFavorables}" VerticalAlignment="Bottom" RadiusX="3" RadiusY="3"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Libelle}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CarteStyle}">
                    <StackPanel>
                        <TextBlock Text="Défaillances les plus fréquentes" Style="{StaticResource TitreCarte}"/>
                        <DataGrid ItemsSource="{Binding Defaillances}" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                                <DataGridTemplateColumn Header="Défaillance" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Libelle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Libelle}"
                                                       Foreground="{Binding Niveau, Converter={StaticResource CouleurResultat}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Erreur}" Style="{StaticResource MessageErreur}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
