<UserControl x:Class="CT.Desktop.Views.ControlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CT.Desktop.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Contrôles" Style="{StaticResource TitrePage}"/>

        <Border Grid.Row="1" Style="{StaticResource CarteStyle}" Margin="0,0,16,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ComboBox DockPanel.Dock="Left" Width="170" Margin="0,0,8,0"
                              ItemsSource="{x:Static vm:ControlesViewModel.Filtres}" SelectedItem="{Binding Filtre}" DisplayMemberPath="Libelle"/>
                    <CheckBox DockPanel.Dock="Right" Content="Mes contrôles uniquement" IsChecked="{Binding MesControles}" Margin="12,0,0,0"
                              Visibility="{Binding EstInspecteur, Converter={StaticResource BoolVisibilite}}"/>
                    <Button DockPanel.Dock="Right" Content="Rechercher" Command="{Binding RechercherCommand}" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" ToolTip="Immatriculation">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RechercherCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="‹ Précédent" Command="{Binding PagePrecedenteCommand}" Style="{StaticResource BoutonSecondaire}"/>
                    <Button Content="Suivant ›" Command="{Binding PageSuivanteCommand}" Style="{StaticResource BoutonSecondaire}"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaire}">
                        <Run Text="Page"/> <Run Text="{Binding Page, Mode=OneWay}"/> <Run Text="/"/> <Run Text="{Binding NombrePages, Mode=OneWay}"/>
                        <Run Text=" — "/><Run Text="{Binding Total, Mode=OneWay}"/> <Run Text="contrôle(s)"/>
                    </TextBlock>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Controles}" SelectedItem="{Binding ControleSelectionne}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateControle, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Immat." Binding="{Binding Immatriculation}" Width="95"/>
                        <DataGridTextColumn Header="Véhicule" Binding="{Binding Vehicule}" Width="1.3*" MinWidth="120"/>
                        <DataGridTextColumn Header="Inspecteur" Binding="{Binding InspecteurNom}" Width="*" MinWidth="90"/>
                        <DataGridTemplateColumn Header="Statut" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Statut, Converter={StaticResource Libelle}}"
                                                   Foreground="{Binding Statut, Converter={StaticResource CouleurResultat}}"/>
                                        <TextBlock Text=" · CV" FontWeight="SemiBold" Foreground="{StaticResource Primaire}" ToolTip="Contre-visite"
                                                   Visibility="{Binding EstContreVisite, Converter={StaticResource BoolVisibilite}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Résultat" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Resultat, Converter={StaticResource Libelle}}" FontWeight="SemiBold"
                                               Foreground="{Binding Resultat, Converter={StaticResource CouleurResultat}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <Border Style="{StaticResource CarteStyle}" Visibility="{Binding Detail, Converter={StaticResource NullVisibilite}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TitreCarte}">
                        <Run Text="{Binding Detail.Immatriculation, Mode=OneWay}"/> <Run Text="—"/> <Run Text="{Binding Detail.Vehicule, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail.Resultat, Converter={StaticResource Libelle}}" FontSize="20" FontWeight="Bold"
                               Foreground="{Binding Detail.Resultat, Converter={StaticResource CouleurResultat}}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TexteSecondaire}">
                        <Run Text="Statut :"/> <Run Text="{Binding Detail.Statut, Mode=OneWay, Converter={StaticResource Libelle}}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource Primaire}" Margin="0,4,0,0"
                               Visibility="{Binding Detail.DateControleInitial, Converter={StaticResource NullVisibilite}}">
                        <Run Text="Contre-visite du contrôle du"/>
                        <Run Text="{Binding Detail.DateControleInitial, Mode=OneWay, StringFormat=dd/MM/yyyy}"/>
                    </TextBlock>
                    <TextBlock Text="Une contre-visite a été ouverte pour ce contrôle." Foreground="{StaticResource Primaire}" Margin="0,4,0,0"
                               Visibility="{Binding Detail.ContreVisiteId, Converter={StaticResource NullVisibilite}}"/>
                    <TextBlock Style="{StaticResource Etiquette}" Text="Propriétaire"/>
                    <TextBlock Text="{Binding Detail.ProprietaireNom}"/>
                    <TextBlock Style="{StaticResource Etiquette}" Text="Inspecteur"/>
                    <TextBlock Text="{Binding Detail.InspecteurNom}"/>
                    <TextBlock Style="{StaticResource Etiquette}" Text="Kilométrage"/>
                    <TextBlock Text="{Binding Detail.Kilometrage, StringFormat={}{0:N0} km}"/>
                    <TextBlock Style="{StaticResource Etiquette}" Text="Valide jusqu'au"/>
                    <TextBlock Text="{Binding Detail.DateFinValidite, StringFormat=dd/MM/yyyy, TargetNullValue='—'}"/>
                    <TextBlock Style="{StaticResource Etiquette}" Text="Observations"/>
                    <TextBlock Text="{Binding Detail.Observations, TargetNullValue='Aucune'}" TextWrapping="Wrap"/>

                    <TextBlock Style="{StaticResource Etiquette}" Text="Points non conformes"/>
                    <ItemsControl ItemsSource="{Binding NonConformes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="●" Foreground="{Binding Gravite, Mode=OneWay, Converter={StaticResource CouleurResultat}}"/>
                                    <Run Text="{Binding Libelle, Mode=OneWay}"/>
                                    <Run Text="{Binding Gravite, Mode=OneWay}" Foreground="{StaticResource TexteSecondaire}" FontSize="11"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Reprendre la saisie" Command="{Binding ReprendreCommand}"
                                Visibility="{Binding PeutReprendre, Converter={StaticResource BoolVisibilite}}"/>
                        <Button Content="Ouvrir le PV" Command="{Binding OuvrirPvCommand}"
                                Visibility="{Binding PeutOuvrirPv, Converter={StaticResource BoolVisibilite}}"/>
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding PeutOuvrirContreVisite, Converter={StaticResource BoolVisibilite}}">
                        <TextBlock Text="Contre-visite" Style="{StaticResource TitreCarte}" Margin="0,0,0,4"/>
                        <TextBlock Text="Revérifie uniquement les points non conformes, dans les 2 mois." TextWrapping="Wrap"
                                   FontSize="12" Foreground="{StaticResource TexteSecondaire}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kilométrage" Style="{StaticResource Etiquette}"/>
                                <TextBox Text="{Binding KilometrageContreVisite, TargetNullValue=''}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date" Style="{StaticResource Etiquette}"/>
                                <DatePicker SelectedDate="{Binding DateContreVisite}"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Ouvrir la contre-visite" Command="{Binding OuvrirContreVisiteCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Sélectionnez un contrôle pour voir son détail." Foreground="{StaticResource TexteSecondaire}"
                       Visibility="{Binding Detail, Converter={StaticResource NullInvisibilite}}"/>
            <TextBlock Text="{Binding Erreur}" Style="{StaticResource MessageErreur}"/>
        </StackPanel>
    </Grid>
</UserControl>
