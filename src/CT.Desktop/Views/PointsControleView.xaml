<UserControl x:Class="CT.Desktop.Views.PointsControleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Points de contrôle" Style="{StaticResource TitrePage}"/>

        <Border Grid.Row="1" Style="{StaticResource CarteStyle}" Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding PointsParCategorie}" SelectedItem="{Binding PointSelectionne}" ColumnWidth="SizeToHeader">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Primaire}" Margin="8,10,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="400"/>
                    <DataGridTemplateColumn Header="Gravité" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Gravite}" Foreground="{Binding Gravite, Converter={StaticResource CouleurResultat}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <Border Style="{StaticResource CarteStyle}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Nouveau" Command="{Binding NouveauCommand}" Style="{StaticResource BoutonSecondaire}" Margin="0"/>
                        <TextBlock Text="{Binding TitreFormulaire}" Style="{StaticResource TitreCarte}"/>
                    </DockPanel>
                    <TextBlock Text="Catégorie" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Categorie}" DisplayMemberPath="Libelle"/>
                    <TextBlock Text="Libellé" Style="{StaticResource Etiquette}"/>
                    <TextBox Text="{Binding Libelle}"/>
                    <TextBlock Text="Gravité" Style="{StaticResource Etiquette}"/>
                    <ComboBox ItemsSource="{Binding Gravites}" SelectedItem="{Binding Gravite}"/>
                    <CheckBox Content="Actif (proposé lors des contrôles)" IsChecked="{Binding Actif}" Margin="0,12,0,0"/>
                    <TextBlock Text="Un point désactivé n'est jamais supprimé : les anciens contrôles le conservent."
                               FontSize="11" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Button Content="Enregistrer" Command="{Binding EnregistrerCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Erreur}" Style="{StaticResource MessageErreur}"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageSucces}"/>
        </StackPanel>
    </Grid>
</UserControl>
